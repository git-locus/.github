# app.env.example – runtime variables of the Locus container on Azure.
# Encode it in base64 and save it as the APP_ENV_VARS_B64 secret of the
# docker2azure4student repository (used only to initialise the environment):
#   base64 -w0 app.env > tmp.b64   # Linux
#   base64 < app.env | tr -d '\n'  # macOS

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api/

# ── Domain and TLS ─────────────────────────────────────────────────────────────
DOMAIN=<public domain of the VM, e.g. locus.now>
LETS_ENCRYPT_EMAIL=<e-mail for Let's Encrypt, e.g. ops@locus.now>

# ── Django ────────────────────────────────────────────────────────────────────
# generate with: openssl rand -base64 48
SECRET_KEY=changeme_generate_with_openssl_rand_base64_48
DJANGO_SETTINGS_MODULE=api.settings_prod
SERVER_HOST=<public domain, e.g. locus.now>
SERVER_URL=https://<public domain>

# ── JWT ───────────────────────────────────────────────────────────────────────
# generate with: openssl rand -base64 48
JWT_SECRET=changeme_generate_with_openssl_rand_base64_48

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_ENGINE=django.db.backends.postgresql
POSTGRES_NAME=<database name>
POSTGRES_USER=<Azure PostgreSQL username>
POSTGRES_PASSWORD=<Azure PostgreSQL password>
POSTGRES_HOST=<FQDN of the Azure PostgreSQL server, e.g. locus-pg-xxxx.postgres.database.azure.com>
POSTGRES_PORT=5432

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# For Azure cloud (production): account name and key.
AZURE_ACCOUNT_NAME=<name of the Azure storage account>
AZURE_ACCOUNT_KEY=<access key of the Azure storage account>
# Alternatively (e.g. Azurite locally): a full connection string.
# If set, it takes priority over AZURE_ACCOUNT_NAME/AZURE_ACCOUNT_KEY.
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=...;BlobEndpoint=http://azurite:10000/devstoreaccount1;
